<Window x:Class="LiveFastTranslation.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:LiveFastTranslation.Views.Converters"
        Title="Live-Fast Translation"
        Width="356"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        Focusable="False"
        Opacity="0"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        MouseRightButtonUp="Window_MouseRightButtonUp"
        PreviewKeyDown="Window_PreviewKeyDown"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="10">
        <Border x:Name="Capsule"
                AutomationProperties.AutomationId="OverlayCapsule"
                MinHeight="40"
                CornerRadius="9"
                Background="{DynamicResource OverlayBackgroundBrush}"
                BorderBrush="{DynamicResource OverlayBorderBrush}"
                BorderThickness="1"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20"
                                  ShadowDepth="3"
                                  Direction="270"
                                  Opacity="0.26"
                                  Color="{DynamicResource ShadowColor}" />
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="CapsuleOffset" />
            </Border.RenderTransform>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Drag handle and source-language badge -->
                <Border Grid.Column="0"
                        Background="Transparent"
                        Cursor="SizeAll"
                        ToolTip="{Binding DirectionText}"
                        MouseLeftButtonDown="DragHandle_MouseLeftButtonDown">
                    <TextBlock Text="{Binding SourceBadge}"
                               AutomationProperties.AutomationId="OverlaySourceBadge"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <Border Grid.Column="0"
                        Width="1"
                        Height="18"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="{DynamicResource OverlaySeparatorBrush}" />

                <!-- Content states -->
                <Grid Grid.Column="1" MinHeight="38" Margin="10,0,8,0" VerticalAlignment="Center">
                    <Grid Visibility="{Binding ShowLoading, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse Stroke="{DynamicResource AccentBrush}"
                                     StrokeThickness="1.6"
                                     StrokeDashArray="2 2.6"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform />
                                </Ellipse.RenderTransform>
                                <Ellipse.Style>
                                    <Style TargetType="{x:Type Ellipse}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="SpinStoryboard">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                             From="0"
                                                                             To="360"
                                                                             Duration="0:0:0.85"
                                                                             RepeatBehavior="Forever" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="SpinStoryboard" />
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </Grid>
                        <TextBlock Grid.Column="1"
                                   Text="Перевод…"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding SourcePreview}"
                                   Margin="9,0,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock AutomationProperties.AutomationId="OverlayErrorText"
                               Text="{Binding ErrorMessage}"
                               ToolTip="{Binding ErrorMessage}"
                               Visibility="{Binding ShowError, Converter={StaticResource BoolToVisibility}}"
                               Foreground="{DynamicResource ErrorBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               MaxHeight="{Binding MaxTranslationHeight}"
                               VerticalAlignment="Center"
                               Cursor="Hand"
                               MouseLeftButtonUp="Error_MouseLeftButtonUp" />

                    <Border Visibility="{Binding ShowResult, Converter={StaticResource BoolToVisibility}}"
                            Background="Transparent"
                            Cursor="Hand"
                            ToolTip="{Binding ActionHint}"
                            MouseLeftButtonUp="Result_MouseLeftButtonUp">
                        <TextBlock AutomationProperties.AutomationId="OverlayTranslationText"
                                   Text="{Binding Translation}"
                                   FontFamily="{Binding OverlayFontFamily}"
                                   FontSize="{Binding OverlayFontSize}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   MaxHeight="{Binding MaxTranslationHeight}"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding ShowNotice, Converter={StaticResource BoolToVisibility}}">
                        <Path Data="M 3 8 L 6.5 11.5 L 13 4.5"
                              Width="12"
                              Height="12"
                              Stretch="Uniform"
                              Stroke="{DynamicResource SuccessBrush}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center" />
                        <TextBlock AutomationProperties.AutomationId="OverlayNoticeText"
                                   Text="{Binding NoticeMessage}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Target language, AI toggle, settings, close -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,5,0">
                    <ComboBox AutomationProperties.AutomationId="OverlayLanguageCombo"
                              AutomationProperties.Name="Язык перевода"
                              Width="86"
                              Style="{StaticResource CompactComboBoxStyle}"
                              ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                              DisplayMemberPath="DisplayText"
                              ToolTip="Язык перевода"
                              Margin="0,0,3,0"
                              VerticalAlignment="Center" />
                    <ToggleButton AutomationProperties.AutomationId="OverlayAiToggle"
                                  AutomationProperties.Name="AI-режим"
                                  Style="{StaticResource OverlayToggleButton}"
                                  IsChecked="{Binding IsAiMode, Mode=TwoWay}"
                                  Content="AI"
                                  ToolTip="AI-режим: переводить предложения во время набора"
                                  Margin="0,0,2,0" />
                    <Button AutomationProperties.AutomationId="OverlaySettingsButton"
                            AutomationProperties.Name="Настройки"
                            Style="{StaticResource OverlayIconButton}"
                            Command="{Binding SettingsCommand}"
                            ToolTip="Настройки"
                            Margin="0,0,1,0">
                        <Path Data="M 3 6 H 21 M 3 12 H 21 M 3 18 H 21 M 15.5 4 A 2 2 0 1 0 15.5 8 A 2 2 0 1 0 15.5 4 M 7.5 10 A 2 2 0 1 0 7.5 14 A 2 2 0 1 0 7.5 10 M 16.5 16 A 2 2 0 1 0 16.5 20 A 2 2 0 1 0 16.5 16"
                              Width="14"
                              Height="14"
                              Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              StrokeThickness="1.2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                    </Button>
                    <Button AutomationProperties.AutomationId="OverlayCloseButton"
                            AutomationProperties.Name="Закрыть"
                            Style="{StaticResource OverlayIconButton}"
                            Command="{Binding CloseCommand}"
                            ToolTip="Закрыть">
                        <Path Data="M 4.5 4.5 L 11.5 11.5 M 11.5 4.5 L 4.5 11.5"
                              Width="12"
                              Height="12"
                              Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              StrokeThickness="1.3"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
