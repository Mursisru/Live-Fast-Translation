<Window x:Class="LiveFastTranslation.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Live-Fast Translation"
        Width="430"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="{DynamicResource AppFontFamily}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Margin="18"
            Background="{DynamicResource SurfaceRaisedBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            MouseLeftButtonDown="Chrome_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22"
                               ShadowDepth="4"
                               Direction="270"
                               Opacity="0.28"
                               Color="#000000" />
        </Border.Effect>

        <Grid Margin="22,20,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <Border Width="26"
                        Height="26"
                        CornerRadius="13"
                        Background="{DynamicResource ErrorSoftBrush}"
                        VerticalAlignment="Top">
                    <Path Data="M 8 8 L 18 18 M 18 8 L 8 18"
                          Width="10"
                          Height="10"
                          Stretch="Uniform"
                          Stroke="{DynamicResource ErrorBrush}"
                          StrokeThickness="1.6"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="TitleText"
                           AutomationProperties.AutomationId="ConfirmDialogTitle"
                           Margin="12,2,0,0"
                           FontSize="14.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock x:Name="MessageText"
                       Grid.Row="1"
                       AutomationProperties.AutomationId="ConfirmDialogMessage"
                       Margin="38,10,0,0"
                       FontSize="12.5"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       LineHeight="19" />

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,22,0,0">
                <Button x:Name="ConfirmButton"
                        AutomationProperties.AutomationId="ConfirmDialogConfirmButton"
                        Style="{StaticResource DangerGhostButton}"
                        MinWidth="120"
                        Click="Confirm_Click" />
                <Button x:Name="CancelButton"
                        AutomationProperties.AutomationId="ConfirmDialogCancelButton"
                        Style="{StaticResource PrimaryButton}"
                        Content="Отмена"
                        MinWidth="96"
                        Margin="10,0,0,0"
                        IsDefault="True"
                        Click="Cancel_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
