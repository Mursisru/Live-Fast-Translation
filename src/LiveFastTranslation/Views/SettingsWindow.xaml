                                                Content="Сбросить по умолчанию"
                                                Command="{Binding ResetHotkeysCommand}"
                                                Style="{StaticResource SecondaryButton}"
                                                HorizontalAlignment="Left" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SoftCardBorder}">
                                <StackPanel Margin="16,13">
                                    <TextBlock Text="Если сочетание не регистрируется" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
