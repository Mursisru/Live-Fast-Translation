                            <Border Style="{StaticResource SettingCard}">
                                <StackPanel>
                                    <StackPanel Style="{StaticResource CardHeader}">
                                        <TextBlock Text="Сочетания" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0"
