<Window x:Class="LiveFastTranslation.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:LiveFastTranslation.Views.Controls"
        xmlns:conv="clr-namespace:LiveFastTranslation.Views.Converters"
        Title="Live-Fast Translation — Настройки"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1020"
        Height="730"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource AppBackgroundBrush}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        StateChanged="Window_StateChanged">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"
                            CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibility" />
        <conv:SectionVisibilityConverter x:Key="SectionVisibility" />
        <conv:BoolToBrushConverter x:Key="BoolToBrush" />

        <DataTemplate x:Key="ProviderItemTemplate">
            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
        <!-- Theme gallery card: a miniature of the app painted with the theme palette. -->
        <DataTemplate x:Key="ThemeCardTemplate">
            <Border Width="118"
                    Height="88"
                    Background="{Binding PreviewBackground}"
                    BorderBrush="{Binding PreviewBorder}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="18" Height="6" CornerRadius="2" Background="{Binding PreviewAccent}" />
                        <Border Width="30" Height="4" CornerRadius="1" Background="{Binding PreviewMuted}"
                                Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Border Grid.Row="1"
                            Background="{Binding PreviewPanel}"
                            BorderBrush="{Binding PreviewBorder}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Margin="0,6,0,0"
                            Padding="6,0">
                        <StackPanel VerticalAlignment="Center">
                            <Border Height="4" Width="56" CornerRadius="1" HorizontalAlignment="Left"
                                    Background="{Binding PreviewText}" />
                            <Border Height="4" Width="38" CornerRadius="1" HorizontalAlignment="Left"
                                    Background="{Binding PreviewMuted}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Row="2"
                               Text="{Binding Name}"
                               Foreground="{Binding PreviewText}"
                               FontSize="10"
                               Margin="0,5,0,0"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="ThemeCardItem" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
            <Setter Property="AutomationProperties.AutomationId" Value="{Binding Id}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Selection"
                                CornerRadius="7"
                                BorderThickness="2"
                                BorderBrush="Transparent"
                                Padding="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Selection" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Selection" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="LanguageItemTemplate">
            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
        <DataTemplate x:Key="NamedOptionItemTemplate">
            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>

        <Style x:Key="SectionStack" TargetType="{x:Type StackPanel}">
            <Setter Property="MaxWidth" Value="760" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="SettingCard" TargetType="{x:Type Border}" BasedOn="{StaticResource CardBorder}">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="CardHeader" TargetType="{x:Type StackPanel}">
            <Setter Property="Margin" Value="16,13,16,12" />
        </Style>

        <Style x:Key="RowLabel" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SearchTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="CaptionButtonSmall" TargetType="{x:Type Button}" BasedOn="{StaticResource CaptionButton}" />

        <Style x:Key="StatusBadge" TargetType="{x:Type Border}" BasedOn="{StaticResource BadgeBorder}">
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>

        <Style x:Key="ProviderComboItem" TargetType="{x:Type ComboBoxItem}" BasedOn="{StaticResource ComboBoxItemStyle}">
            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
        </Style>
        <Style x:Key="LanguageComboItem" TargetType="{x:Type ComboBoxItem}" BasedOn="{StaticResource ComboBoxItemStyle}">
            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
        </Style>
        <Style x:Key="NamedOptionComboItem" TargetType="{x:Type ComboBoxItem}" BasedOn="{StaticResource ComboBoxItemStyle}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
        </Style>

        <Style x:Key="RowValue" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="MinWidth" Value="62" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
                <RowDefinition Height="56" />
            </Grid.RowDefinitions>

            <!-- ============================ Title bar ============================ -->
            <Grid Grid.Row="0"
                  Background="{DynamicResource SurfaceAltBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/app-icon.png"
                           Width="18"
                           Height="18"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Настройки"
                               AutomationProperties.AutomationId="SettingsTitleText"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               Margin="9,0,0,0" />
                    <Border Width="1" Height="14" Background="{DynamicResource BorderBrush}" Margin="10,0" />
                    <TextBlock Text="Live-Fast Translation"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource CaptionButtonSmall}"
                            ToolTip="Свернуть"
                            Click="MinimizeButton_Click">
                        <Path Data="M 3 8 H 13"
                              Width="16"
                              Height="16"
                              Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              StrokeThickness="1.1"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Button>
                    <Button Style="{StaticResource CaptionButtonSmall}"
                            AutomationProperties.AutomationId="MaximizeButton"
                            ToolTip="Развернуть"
                            Click="MaximizeButton_Click">
                        <Path x:Name="MaximizeIcon"
                              Data="M 3.5 3.5 H 12.5 V 12.5 H 3.5 Z"
                              Width="16"
                              Height="16"
                              Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              StrokeThickness="1.1"
                              StrokeLineJoin="Round" />
                    </Button>
                    <Button Style="{StaticResource CloseCaptionButton}"
                            AutomationProperties.AutomationId="CloseButton"
                            ToolTip="Закрыть"
                            Click="CloseButton_Click">
                        <Path Data="M 4 4 L 12 12 M 12 4 L 4 12"
                              Width="16"
                              Height="16"
                              Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              StrokeThickness="1.1"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ============================ Body ============================ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="236" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Margin="14,14,14,8">
                            <Border Height="28"
                                    Background="{DynamicResource InputBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="22" />
                                    </Grid.ColumnDefinitions>

                                    <Path Data="M 7 2.5 A 4.5 4.5 0 1 0 7 11.5 A 4.5 4.5 0 1 0 7 2.5 M 10.4 10.4 L 14 14"
                                          Width="16"
                                          Height="16"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource TextMutedBrush}"
                                          StrokeThickness="1.3"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False" />

                                    <TextBox x:Name="SearchBox"
                                             Grid.Column="1"
                                             AutomationProperties.AutomationId="SettingsSearchBox"
                                             AutomationProperties.Name="Поиск по настройкам"
                                             Style="{StaticResource SearchTextBox}"
                                             Text="{Binding SettingsSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="1"
                                               Text="Поиск по настройкам"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Visibility="{Binding SettingsSearchText, Converter={StaticResource StringNotEmptyToVisibility}, ConverterParameter=invert}" />

                                    <Button Grid.Column="2"
                                            AutomationProperties.AutomationId="ClearSearchButton"
                                            Style="{StaticResource GhostButton}"
                                            Width="18"
                                            Height="18"
                                            MinHeight="0"
                                            Padding="0"
                                            ToolTip="Очистить поиск"
                                            Command="{Binding ClearSearchCommand}"
                                            Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVisibility}}">
                                        <Path Data="M 3.5 3.5 L 8.5 8.5 M 8.5 3.5 L 3.5 8.5"
                                              Width="11"
                                              Height="11"
                                              Stretch="Uniform"
                                              Stroke="{DynamicResource TextMutedBrush}"
                                              StrokeThickness="1.2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" />
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1">
                            <ListBox x:Name="NavList"
                                     AutomationProperties.AutomationId="NavSections"
                                     AutomationProperties.Name="Разделы настроек"
                                     Margin="8,2,8,8"
                                     ItemsSource="{Binding VisibleSections}"
                                     SelectedValuePath="Value"
                                     SelectedValue="{Binding SelectedSection, Mode=TwoWay}"
                                     ItemContainerStyle="{StaticResource SettingsNavListBoxItem}"
                                     SelectionChanged="NavList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ToolTip="{Binding Description}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Path Data="{Binding IconPath}"
                                                  Style="{StaticResource SectionIcon}"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  Visibility="{Binding IconImage, Converter={StaticResource StringNotEmptyToVisibility}, ConverterParameter=invert}" />
                                            <Rectangle Width="16" Height="16"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Center"
                                                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                                                       Visibility="{Binding IconImage, Converter={StaticResource StringNotEmptyToVisibility}}">
                                                <Rectangle.OpacityMask>
                                                    <ImageBrush ImageSource="{Binding IconImage}" Stretch="Uniform" />
                                                </Rectangle.OpacityMask>
                                            </Rectangle>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Title}"
                                                       FontSize="12.5"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="Ничего не найдено"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="18,10,18,0"
                                       Visibility="{Binding HasVisibleSections, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                        </Grid>

                        <StackPanel Grid.Row="2" Margin="18,8,18,14">
                            <Border Style="{StaticResource Divider}" Margin="0,0,0,10" />
                            <TextBlock Text="{Binding VersionText, StringFormat={}Версия {0}}"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="Ctrl+F — поиск, Ctrl+S — сохранить"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Content -->
                <ScrollViewer Grid.Column="1"
                              x:Name="SettingsContentScroll"
                              AutomationProperties.AutomationId="SettingsContentScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="34,26,34,26">
                    <Grid x:Name="SectionHost" RenderTransformOrigin="0.5,0">
                        <Grid.RenderTransform>
                            <TranslateTransform X="0" Y="0" />
                        </Grid.RenderTransform>

                        <!-- ============================ PROVIDER ============================ -->
                        <StackPanel Style="{StaticResource SectionStack}"
                                    Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=Provider}">
                            <TextBlock Text="Провайдер" Style="{StaticResource PageTitle}" />
                            <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,14"
                                       Text="Чем переводить выделенный текст и какие языки доступны." />

                            <Border Background="{DynamicResource AccentSoftBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,9"
                                    Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Data="M 8 2 A 6 6 0 1 0 8 14 A 6 6 0 1 0 8 2 M 8 7.2 V 11 M 8 4.8 V 5.1"
                                          Width="16"
                                          Height="16"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource AccentBrush}"
                                          StrokeThickness="1.4"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          VerticalAlignment="Top"
                                          Margin="0,2,0,0" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding TranslationModeDescription}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextWrapping="Wrap"
                                               LineHeight="17" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingCard}">
                                <StackPanel>
                                    <StackPanel Style="{StaticResource CardHeader}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Стандартный перевод" Style="{StaticResource SectionTitle}" />
                                            <Border Style="{StaticResource StatusBadge}" Background="{DynamicResource SelectedBrush}">
                                                <TextBlock Text="Argos Translate" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0"
                                                   Text="Локальный офлайн-переводчик. Работает без интернета после установки моделей и используется, когда AI-режим выключен." />
                                    </StackPanel>
                                    <Border Style="{StaticResource RowDivider}" />

                                    <Border Style="{StaticResource SettingRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Команда Python" Style="{StaticResource RowLabel}" Margin="0" />
                                                <TextBlock Style="{StaticResource HintText}" Margin="0,3,0,0"
                                                           Text="Оставьте пустым для автоопределения. Например: py -3, python или python3." />
                                            </StackPanel>
                                            <ComboBox Grid.Column="1"
                                                      AutomationProperties.AutomationId="ArgosPythonCommandCombo"
                                                      AutomationProperties.Name="Команда Python"
                                                      IsEditable="True"
                                                      IsTextSearchEnabled="False"
                                                      ItemsSource="{Binding ArgosAvailableModels}"
                                                      Text="{Binding ArgosTranslateModelType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource RowDivider}" />

                                    <Border Style="{StaticResource SettingRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Проверка" Style="{StaticResource RowLabel}" Margin="0" />
                                                <TextBlock Style="{StaticResource HintText}" Margin="0,3,0,0"
                                                           Text="Переводит короткую тестовую фразу локально." />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button AutomationProperties.AutomationId="TestArgosButton"
                                                            AutomationProperties.Name="Проверить Argos Translate"
                                                            Content="Проверить"
                                                            Command="{Binding TestArgosTranslateConnectionCommand}"
                                                            Style="{StaticResource SecondaryButton}"
                                                            IsEnabled="{Binding IsNotTestingArgosTranslate}" />
                                                    <Border AutomationProperties.AutomationId="ArgosTestBadge"
                                                            AutomationProperties.Name="{Binding ArgosTestBadgeText}"
                                                            Style="{StaticResource StatusBadge}"
                                                            Background="{Binding ArgosTestBadgeBrush}"
                                                            Visibility="{Binding ShowArgosTestBadge, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock AutomationProperties.AutomationId="ArgosTestBadgeText"
                                                                   Text="{Binding ArgosTestBadgeText}"
                                                                   Foreground="{DynamicResource OnAccentBrush}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock AutomationProperties.AutomationId="ArgosTestStatusText"
                                                           Text="{Binding ArgosTranslateTestStatus}"
                                                           Foreground="{Binding ArgosTranslateTestStatusBrush}"
                                                           FontSize="11.5"
                                                           TextWrapping="Wrap"
                                                           Margin="0,7,0,0"
                                                           Visibility="{Binding HasArgosTranslateTestStatus, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingCard}">
                                <StackPanel>
                                    <StackPanel Style="{StaticResource CardHeader}">
                                        <TextBlock Text="ИИ-провайдер" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0"
                                                   Text="Используется, когда AI-режим включён: перевод выделенного текста и live-перевод при наборе." />
                                    </StackPanel>
                                    <Border Style="{StaticResource RowDivider}" />

                                    <Border Style="{StaticResource SettingRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Сервис" Style="{StaticResource RowLabel}" Margin="0" />
                                                <TextBlock Text="{Binding AiProviderDescription}" Style="{StaticResource HintText}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <ComboBox Grid.Column="1"
                                                      AutomationProperties.AutomationId="AiProviderCombo"
                                                      AutomationProperties.Name="ИИ-сервис"
                                                      ItemsSource="{Binding AiProviders}"
                                                      SelectedItem="{Binding SelectedAiProvider, Mode=TwoWay}"
                                                      ItemTemplate="{StaticResource ProviderItemTemplate}"
                                                      ItemContainerStyle="{StaticResource ProviderComboItem}" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource RowDivider}" />

                                    <Border Style="{StaticResource SettingRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Родной язык" Style="{StaticResource RowLabel}" Margin="0" />
                                                <TextBlock Text="{Binding AvailableLanguagesHint}" Style="{StaticResource HintText}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <ComboBox AutomationProperties.AutomationId="TargetLanguageCombo"
                                                          AutomationProperties.Name="Родной язык"
                                                          ItemsSource="{Binding Languages}"
                                                          SelectedItem="{Binding TargetLanguage, Mode=TwoWay}"
                                                          ItemTemplate="{StaticResource LanguageItemTemplate}"
                                                          ItemContainerStyle="{StaticResource LanguageComboItem}" />
                                                <TextBlock Style="{StaticResource HintText}" Margin="0,5,0,0"
                                                           Text="Язык перевода выбирается автоматически: на родной язык и с родного на английский." />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource RowDivider}"
                                            Visibility="{Binding ShowAiApiKey, Converter={StaticResource BoolToVisibility}}" />
                                    <Border Style="{StaticResource SettingRow}"
                                            Visibility="{Binding ShowAiApiKey, Converter={StaticResource BoolToVisibility}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="API-ключ" Style="{StaticResource RowLabel}" Margin="0" />
                                                <TextBlock Text="{Binding AiApiKeyHint}" Style="{StaticResource HintText}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <PasswordBox Grid.Column="1"
                                                         AutomationProperties.AutomationId="AiApiKeyBox"
                                                         AutomationProperties.Name="API-ключ"
                                                         controls:PasswordBoxHelper.BoundPassword="{Binding AiApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource RowDivider}"
                                            Visibility="{Binding ShowAiModel, Converter={StaticResource BoolToVisibility}}" />
                                    <Border Style="{StaticResource SettingRow}"
                                            Visibility="{Binding ShowAiModel, Converter={StaticResource BoolToVisibility}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Модель" Style="{StaticResource RowLabel}" Margin="0" />
                                                <TextBlock Text="{Binding AiModelHint}" Style="{StaticResource HintText}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
