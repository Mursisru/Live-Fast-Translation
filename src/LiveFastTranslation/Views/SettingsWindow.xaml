                                                       Margin="0,7,0,0"
                                                       Visibility="{Binding HasAiTestStatus, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============================ REPLACEMENT ============================ -->
                        <StackPanel Style="{StaticResource SectionStack}"
                                    Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=Replacement}">
