                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                            <ListBox x:Name="ThemeGallery"
                                                     AutomationProperties.AutomationId="ThemeGallery"
                                                     AutomationProperties.Name="Галерея тем"
                                                     Height="318"
                                                     Margin="0,10,0,0"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Padding="0"
                                                     HorizontalContentAlignment="Stretch"
                                                     ItemsSource="{Binding ThemesView}"
                                                     SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                                                     ItemTemplate="{StaticResource ThemeCardTemplate}"
                                                     ItemContainerStyle="{StaticResource ThemeCardItem}"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>
                                                <ListBox.GroupStyle>
                                                    <GroupStyle>
                                                        <GroupStyle.ContainerStyle>
                                                            <Style TargetType="{x:Type GroupItem}">
                                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="{x:Type GroupItem}">
                                                                            <StackPanel>
                                                                                <ContentPresenter Content="{TemplateBinding Content}"
                                                                                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
                                                                                <ItemsPresenter />
                                                                            </StackPanel>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </GroupStyle.ContainerStyle>
                                                        <GroupStyle.HeaderTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Name}"
                                                                           Style="{StaticResource CaptionText}"
                                                                           Margin="2,8,0,7" />
                                                            </DataTemplate>
                                                        </GroupStyle.HeaderTemplate>
                                                        <GroupStyle.Panel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Vertical" />
                                                            </ItemsPanelTemplate>
                                                        </GroupStyle.Panel>
                                                    </GroupStyle>
                                                </ListBox.GroupStyle>
                                            </ListBox>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource RowDivider}" />

                                    <Border Style="{StaticResource SettingRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Шрифт интерфейса" Style="{StaticResource RowLabel}" Margin="0" />
                                                <TextBlock Text="Применяется ко всем окнам." Style="{StaticResource HintText}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <ComboBox Grid.Column="1"
                                                      AutomationProperties.AutomationId="FontFamilyCombo"
                                                      AutomationProperties.Name="Шрифт интерфейса"
                                                      IsEditable="True"
                                                      IsTextSearchEnabled="False"
                                                      ItemsSource="{Binding FontFamilies}"
                                                      Text="{Binding FontFamilyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingCard}">
                                <StackPanel>
                                    <StackPanel Style="{StaticResource CardHeader}">
                                        <TextBlock Text="Окно перевода" Style="{StaticResource SectionTitle}" />
                                    </StackPanel>
                                    <Border Style="{StaticResource RowDivider}" />

                                    <Border Style="{StaticResource SettingRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Непрозрачность окна" Style="{StaticResource RowLabel}" />
                                            <Grid Grid.Column="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Slider AutomationProperties.AutomationId="OverlayOpacitySlider"
                                                        Minimum="0.3" Maximum="1" SmallChange="0.01" LargeChange="0.05"
                                                        VerticalAlignment="Center"
                                                        Value="{Binding OpacityPercent, Mode=TwoWay}" />
                                                <TextBlock Grid.Column="1" Text="{Binding OpacityText}" Style="{StaticResource RowValue}" Margin="12,0,0,0" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource RowDivider}" />

                                    <Border Style="{StaticResource SettingRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="Прозрачность фона" Style="{StaticResource RowLabel}" Margin="0" />
                                                <TextBlock Text="Текст остаётся полностью непрозрачным."
                                                           Style="{StaticResource HintText}"
                                                           Margin="0,3,0,0"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Grid Grid.Column="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Slider AutomationProperties.AutomationId="OverlayBackgroundTransparencySlider"
                                                        Minimum="0" Maximum="0.7" SmallChange="0.01" LargeChange="0.05"
                                                        VerticalAlignment="Center"
                                                        Value="{Binding BackgroundTransparency, Mode=TwoWay}" />
                                                <TextBlock Grid.Column="1" Text="{Binding BackgroundTransparencyText}" Style="{StaticResource RowValue}" Margin="12,0,0,0" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource RowDivider}" />

                                    <Border Style="{StaticResource SettingRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Размер шрифта" Style="{StaticResource RowLabel}" />
                                            <Grid Grid.Column="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Slider AutomationProperties.AutomationId="OverlayFontSizeSlider"
                                                        Minimum="10" Maximum="28" SmallChange="0.5" LargeChange="2"
                                                        VerticalAlignment="Center"
                                                        Value="{Binding OverlayFontSize, Mode=TwoWay}" />
                                                <TextBlock Grid.Column="1" Text="{Binding OverlayFontSizeText}" Style="{StaticResource RowValue}" Margin="12,0,0,0" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource RowDivider}" />

                                    <Border Style="{StaticResource SettingRow}">
                                        <CheckBox IsChecked="{Binding ShowLanguageFlags, Mode=TwoWay}">
                                            <TextBlock Text="Показывать флаги языков" FontSize="12.5" />
                                        </CheckBox>
                                    </Border>
                                    <Border Style="{StaticResource RowDivider}" />

                                    <Border Style="{StaticResource SettingRow}">
                                        <CheckBox IsChecked="{Binding ShowLanguageCodes, Mode=TwoWay}">
                                            <TextBlock Text="Показывать коды языков" FontSize="12.5" />
                                        </CheckBox>
                                    </Border>
                                    <Border Style="{StaticResource RowDivider}" />

                                    <Border Style="{StaticResource SettingRow}">
                                        <CheckBox IsChecked="{Binding EnableAnimations, Mode=TwoWay}">
                                            <TextBlock Text="Включить анимации появления" FontSize="12.5" />
                                        </CheckBox>
                                    </Border>
                                    <Border Style="{StaticResource RowDivider}" />

                                    <Border Style="{StaticResource SettingRow}">
                                        <CheckBox AutomationProperties.AutomationId="MinimalOverlayCheckBox"
                                                  IsChecked="{Binding MinimalOverlay, Mode=TwoWay}">
                                            <StackPanel>
                                                <TextBlock Text="Минималистичный режим строки" FontSize="12.5" />
                                                <TextBlock Text="Скрыть язык, AI, настройки и закрытие — останется только перевод."
                                                           Style="{StaticResource HintText}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </CheckBox>
                                    </Border>
                                    <Border Style="{StaticResource RowDivider}" />

                                    <Border Style="{StaticResource SettingRow}">
                                        <CheckBox AutomationProperties.AutomationId="AutoShowOverlayCheckBox"
                                                  IsChecked="{Binding AutoShowOverlay, Mode=TwoWay}">
                                            <StackPanel>
                                                <TextBlock Text="Авто появление строки перевода" FontSize="12.5" />
                                                <TextBlock Text="Строка появляется сама при выделении текста — горячая клавиша не нужна."
                                                           Style="{StaticResource HintText}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </CheckBox>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SoftCardBorder}">
                                <StackPanel Margin="16,13">
                                    <TextBlock Text="Предпросмотр" Style="{StaticResource SectionTitle}" />
                                    <Border Background="{DynamicResource OverlayBackgroundBrush}"
                                            BorderBrush="{DynamicResource OverlayBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            MinHeight="40"
                                            Padding="14,0"
                                            HorizontalAlignment="Left"
                                            Margin="0,8,0,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🇬🇧" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Пример перевода текста"
                                                       FontFamily="{Binding FontFamilyName}"
                                                       FontSize="{Binding OverlayFontSize}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Style="{StaticResource HintText}" Text="Так выглядит всплывающее окно с текущими настройками шрифта и прозрачности." />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============================ ADVANCED ============================ -->
                        <StackPanel Style="{StaticResource SectionStack}"
                                    Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=Advanced}">
                            <TextBlock Text="Дополнительно" Style="{StaticResource PageTitle}" />
                            <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,16"
                                       Text="Автозапуск, поведение в трее, история переводов и служебные файлы." />

                            <Border Style="{StaticResource SettingCard}">
                                <StackPanel>
                                    <StackPanel Style="{StaticResource CardHeader}">
                                        <TextBlock Text="Запуск и трей" Style="{StaticResource SectionTitle}" />
                                    </StackPanel>
                                    <Border Style="{StaticResource RowDivider}" />

                                    <Border Style="{StaticResource SettingRow}">
                                        <CheckBox AutomationProperties.AutomationId="AutoStartCheckBox"
                                                  IsChecked="{Binding AutoStart, Mode=TwoWay}">
                                            <StackPanel>
                                                <TextBlock Text="Запускать вместе с Windows" FontSize="12.5" />
                                                <TextBlock Text="HKCU, без прав администратора." Style="{StaticResource HintText}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </CheckBox>
                                    </Border>
                                    <Border Style="{StaticResource RowDivider}" />

                                    <Border Style="{StaticResource SettingRow}">
                                        <CheckBox AutomationProperties.AutomationId="TrayNotificationsCheckBox"
                                                  IsChecked="{Binding ShowTrayNotifications, Mode=TwoWay}">
                                            <StackPanel>
                                                <TextBlock Text="Показывать уведомления в трее" FontSize="12.5" />
                                                <TextBlock Text="Сообщения о смене режима и ошибках." Style="{StaticResource HintText}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </CheckBox>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingCard}">
                                <StackPanel>
                                    <StackPanel Style="{StaticResource CardHeader}">
                                        <TextBlock Text="История переводов" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="{Binding HistoryCountText}" Style="{StaticResource HintText}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Border Style="{StaticResource RowDivider}" />

                                    <Border Style="{StaticResource SettingRow}">
                                        <CheckBox AutomationProperties.AutomationId="SaveHistoryCheckBox"
                                                  IsChecked="{Binding SaveHistory, Mode=TwoWay}">
                                            <TextBlock Text="Сохранять историю переводов" FontSize="12.5" />
                                        </CheckBox>
                                    </Border>
                                    <Border Style="{StaticResource RowDivider}" />

                                    <Border Style="{StaticResource SettingRow}" IsEnabled="{Binding SaveHistory}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Лимит записей" Style="{StaticResource RowLabel}" />
                                            <Grid Grid.Column="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Slider Minimum="0" Maximum="200" SmallChange="1" LargeChange="10"
                                                        VerticalAlignment="Center"
                                                        Value="{Binding HistoryLimit, Mode=TwoWay}" />
                                                <TextBlock Grid.Column="1" Text="{Binding HistoryLimitText}" Style="{StaticResource RowValue}" Margin="12,0,0,0" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource RowDivider}" />

                                    <Border Style="{StaticResource SettingRow}">
                                        <StackPanel>
                                            <Border Background="{DynamicResource InputBackgroundBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="5">
                                                <Grid>
                                                    <ListBox AutomationProperties.AutomationId="HistoryList"
                                                             ItemsSource="{Binding HistoryEntries}"
                                                             Height="136"
                                                             Padding="4"
                                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                             Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibility}}">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Margin="6,4">
                                                                    <TextBlock Text="{Binding Timestamp, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                                                               FontSize="10"
                                                                               Foreground="{DynamicResource TextMutedBrush}" />
                                                                    <TextBlock Text="{Binding SourceText}"
                                                                               FontSize="11.5"
                                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding TranslatedText}"
                                                                               FontSize="11"
                                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                    <TextBlock Text="Последние переводы появятся здесь после вставки."
                                                               Margin="14,16"
                                                               FontSize="11.5"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                                </Grid>
                                            </Border>
                                            <Button AutomationProperties.AutomationId="ClearHistoryButton"
                                                    Content="Очистить историю"
                                                    Command="{Binding ClearHistoryCommand}"
                                                    Style="{StaticResource DangerGhostButton}"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,9,0,0"
                                                    Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingCard}">
                                <StackPanel>
                                    <StackPanel Style="{StaticResource CardHeader}">
                                        <TextBlock Text="Служебные файлы" Style="{StaticResource SectionTitle}" />
                                    </StackPanel>
                                    <Border Style="{StaticResource RowDivider}" />

                                    <Border Style="{StaticResource SettingRow}">
                                        <StackPanel>
                                            <TextBlock Text="settings.json" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                                            <TextBox AutomationProperties.AutomationId="SettingsPathBox"
                                                     Text="{Binding SettingsPath, Mode=OneWay}"
                                                     IsReadOnly="True"
                                                     FontFamily="{StaticResource MonoFontFamily}"
                                                     FontSize="11"
                                                     Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                                                <Button Content="Открыть папку настроек"
                                                        Command="{Binding OpenDataFolderCommand}"
                                                        Style="{StaticResource SecondaryButton}" />
                                                <Button Content="Открыть журнал"
                                                        Command="{Binding OpenLogCommand}"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Margin="8,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding VersionText, StringFormat={}Версия {0}}"
                                                       Style="{StaticResource HintText}"
                                                       Margin="0,12,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- ============================ Footer ============================ -->
            <Border Grid.Row="2"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="20,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Ellipse Width="6" Height="6"
                                 Fill="{Binding StatusIsSuccess, Converter={StaticResource BoolToBrush}}"
                                 Margin="0,0,8,0"
                                 Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{Binding StatusIsSuccess, Converter={StaticResource BoolToBrush}}"
                                   FontSize="11.5"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="Изменения применяются после сохранения."
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Ctrl+S"
                                   FontSize="10.5"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,14,0" />
                        <Button AutomationProperties.AutomationId="CancelButton"
                                AutomationProperties.Name="Отмена"
                                Content="Отмена"
                                Command="{Binding CancelCommand}"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="96" />
                        <Button AutomationProperties.AutomationId="SaveButton"
                                AutomationProperties.Name="Сохранить"
                                Content="Сохранить"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButton}"
                                MinWidth="120"
                                Margin="8,0,0,0"
                                IsDefault="True" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
