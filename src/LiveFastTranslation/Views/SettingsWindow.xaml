                                    <StackPanel Style="{StaticResource CardHeader}">
                                        <TextBlock Text="Тема и шрифт" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0"
                                                   Text="Тема применяется сразу для предпросмотра. Кнопка «Сохранить» закрепляет выбор." />
                                    </StackPanel>
                                    <Border Style="{StaticResource RowDivider}" />

