                                                                HorizontalAlignment="Left"
                                                                Hotkey="{Binding AiHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource RowDivider}" />

                                    <Border Style="{StaticResource SettingRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Открыть настройки" Style="{StaticResource RowLabel}" Margin="0" />
                                                <TextBlock Text="Работает из любого приложения." Style="{StaticResource HintText}" Margin="0,3,0,0" />
