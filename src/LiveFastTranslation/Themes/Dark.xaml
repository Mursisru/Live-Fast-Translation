<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Fallback palette for the default dark theme (dark-sky). Runtime themes are built by ThemeService. -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#252526" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#181818" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#2D2D2E" />
    <SolidColorBrush x:Key="BorderBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#3C3C3D" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E6E6E6" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B3B3B3" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8A8A8A" />
    <SolidColorBrush x:Key="AccentBrush" Color="#5C8DFF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#759EFF" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#537FEA" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2E5C8DFF" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#0A1020" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#F48771" />
    <SolidColorBrush x:Key="ErrorSoftBrush" Color="#3A2422" />
    <SolidColorBrush x:Key="WarningBrush" Color="#CCA700" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#89D185" />
    <SolidColorBrush x:Key="HoverBrush" Color="#2A2A2B" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#385C8DFF" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#252526" />
    <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#F2202020" />
    <SolidColorBrush x:Key="OverlayBorderBrush" Color="#30FFFFFF" />
    <SolidColorBrush x:Key="OverlaySeparatorBrush" Color="#1CFFFFFF" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="#F52A2A2A" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="#E6E6E6" />
    <SolidColorBrush x:Key="ScrollBarBrush" Color="#4A4A4D" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#303031" />
    <Color x:Key="ShadowColor">#A0000000</Color>
</ResourceDictionary>
