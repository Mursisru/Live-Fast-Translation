<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Fallback palette for the default light theme (light-sky). Runtime themes are built by ThemeService. -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F6F6F7" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F1F1F2" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E4E4E6" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#CFCFD2" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5C5C61" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8A8A8F" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2F6BFF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#2A60E5" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#2655CC" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1A2F6BFF" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="ErrorSoftBrush" Color="#FDE7E9" />
    <SolidColorBrush x:Key="WarningBrush" Color="#9A6700" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#0F7B3F" />
    <SolidColorBrush x:Key="HoverBrush" Color="#ECECEE" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#242F6BFF" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#F7FFFFFF" />
    <SolidColorBrush x:Key="OverlayBorderBrush" Color="#221F1F1F" />
    <SolidColorBrush x:Key="OverlaySeparatorBrush" Color="#14000000" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="#F21F1F1F" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ScrollBarBrush" Color="#C6C6C9" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#E4E4E6" />
    <Color x:Key="ShadowColor">#26000000</Color>
</ResourceDictionary>
